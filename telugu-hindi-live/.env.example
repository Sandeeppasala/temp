# Azure Speech Translation (Telugu -> Hindi) is the default provider.
# Copy this file to .env and replace placeholders. Never commit .env.
TRANSLATION_PROVIDER=azure
AZURE_SPEECH_KEY=replace-with-your-speech-resource-key
AZURE_SPEECH_REGION=westus
HINDI_VOICE=hi-IN-SwaraNeural

# Use different, strong secrets. Give only EVENT_CODE to listeners.
EVENT_CODE=replace-with-a-long-random-attendee-code
ADMIN_KEY=replace-with-a-different-long-random-admin-password
MAX_LISTENERS=25

# Optional alternative provider: Sarvam.
# Used only if TRANSLATION_PROVIDER=sarvam.
SARVAM_API_KEY=replace-with-your-sarvam-api-key
SARVAM_STT_MODEL=saaras:v4
SARVAM_TRANSLATE_MODEL=sarvam-translate:v1
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
